      <rdf:Description rdf:about=""
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
            xmlns:stRef="http://ns.adobe.com/xap/1.0/sType/ResourceRef#"
            xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#">
         <xmpMM:InstanceID>uuid:554404a5-1970-4d94-9cd9-c8177f8f0523</xmpMM:InstanceID>
         <xmpMM:OriginalDocumentID>adobe:docid:indd:351320ea-b18b-11dd-bb45-d59efdcd6868</xmpMM:OriginalDocumentID>
         <xmpMM:DocumentID>xmp.id:a6433dc8-6655-46cf-980f-5ea58094fb02</xmpMM:DocumentID>
         <xmpMM:RenditionClass>proof:pdf</xmpMM:RenditionClass>
         <xmpMM:DerivedFrom rdf:parseType="Resource">
            <stRef:instanceID>xmp.iid:9947fde1-546b-4b0b-94ec-62a281b8a632</stRef:instanceID>
            <stRef:documentID>xmp.did:a46b310b-d2c8-4108-b4fb-6c544e79366c</stRef:documentID>
            <stRef:originalDocumentID>adobe:docid:indd:351320ea-b18b-11dd-bb45-d59efdcd6868</stRef:originalDocumentID>
            <stRef:renditionClass>default</stRef:renditionClass>
         </xmpMM:DerivedFrom>
