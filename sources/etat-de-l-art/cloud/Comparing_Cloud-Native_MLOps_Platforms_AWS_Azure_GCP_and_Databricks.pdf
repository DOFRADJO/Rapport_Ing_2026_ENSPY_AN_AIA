         <xmpMM:DerivedFrom rdf:parseType="Resource">
            <stRef:instanceID>xmp.iid:3684c877-e4cb-4ef2-ad19-15eb6e4155c7</stRef:instanceID>
            <stRef:documentID>xmp.did:d45e2a04-c643-45b9-bb46-7d4e31fa3598</stRef:documentID>
            <stRef:originalDocumentID>adobe:docid:indd:351320ea-b18b-11dd-bb45-d59efdcd6868</stRef:originalDocumentID>
